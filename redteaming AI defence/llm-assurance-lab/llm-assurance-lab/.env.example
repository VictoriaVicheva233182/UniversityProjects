# Copy to .env and adjust. Environment variables override the YAML configs.
# Provider: ollama | openai | anthropic | simulated
ASSURANCE_LLM_PROVIDER=ollama
ASSURANCE_LLM_MODEL=llama3.1:8b
ASSURANCE_LLM_BASE_URL=http://localhost:11434

# Only needed if you use a hosted provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
